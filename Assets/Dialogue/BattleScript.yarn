
title: BattleBegin
---
Some dialogue
<<declare $voidHealth = 50>>
<<declare $sproutHealth = 100>>
<<declare $attackAmt = 0>>
===

title: Fight
---
SproutAttack
<<set $attackAmt = round(random_range(1, 5))>>
<<set $voidHealth = $voidHealth - $attackAmt>>
SproutDmg: {$attackAmt}
VoidHealth: {$voidHealth}

<<if $voidHealth <= 0>>
    <<jump VoidDeath>>
<<endif>>

VoidAttack
<<set $attackAmt = round(random_range(10, 15))>>
<<set $sproutHealth = $sproutHealth - $attackAmt>>
VoidDmg: {$attackAmt}
SproutHealth: {$sproutHealth}

<<if $sproutHealth <= 0>>
    <<jump SproutDeath>>
<<endif>>
===

title: Act
---
Used Act
<<if visited_count("Act") == 0>>
    Act 1
<<elseif visited_count("Act") == 1>>
    Act 2
<<elseif visited_count("Act") == 2>>
    Act 3
<<elseif visited_count("Act") == 3>>
    Act 4
<<elseif visited_count("Act") == 4>>
    Act 5
<<elseif visited_count("Act") == 5>>
    Act 6
    <<jump ActWin>>
<<endif>>
